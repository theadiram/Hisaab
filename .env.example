# Private by default. Do not enable release until the coverage and security gates pass.
HISAAB_PUBLIC_RELEASE=false
# Explicit read-only public preview; administration still requires private access and MFA.
HISAAB_PUBLIC_PREVIEW=false
HISAAB_DATA_MODE=local
HISAAB_APP_ORIGIN=
# Change to supabase only after applying migrations to a dedicated Hisaab project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Mapbox satellite/terrain; public browser token only, restricted to allowed origins.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
HISAAB_ADMIN_TOKEN=
HISAAB_CAPABILITY_SECRET=
HISAAB_AI_ENABLED=false
OPENAI_API_KEY=
HISAAB_AI_MODEL=
HISAAB_AI_MONTHLY_LIMIT_INR=0
HISAAB_RETENTION_ENABLED=false

# Dedicated, verified Hisaab sender; disabled until configured and explicitly reviewed.
HISAAB_EMAIL_ENABLED=false
HISAAB_REPORT_FROM=
RESEND_API_KEY=
# Immutable geography manifest, generated and uploaded by the hosted geography scripts.
HISAAB_GEOGRAPHY_MANIFEST=
# Optional verified, immutable public map package on a separate static host.
# Example: https://maps.example.com/edition-<package-hash>
NEXT_PUBLIC_HISAAB_MAP_TILE_BASE_URL=

# Optional dedicated public read API; leave BOTH empty for local Supabase.
HISAAB_CATALOGUE_API_URL=
HISAAB_CATALOGUE_API_KEY=
# Pause all application changes while public/private databases are split.
HISAAB_MIGRATION_READ_ONLY=false
